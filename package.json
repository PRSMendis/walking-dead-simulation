{
  "name": "ailo-walking-dead-simulation",
  "version": "0.1.0",
  "description": "Turn-based warehouse simulation for the Ailo coding exercise.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "npm test && npm run simulate:all",
    "start": "npm run build && node dist/src/cli.js sample/scenario.json",
    "simulate": "npm run build && node dist/src/cli.js",
    "simulate:all": "npm run build && node dist/src/run-all-scenarios.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  }
}
